{
  "name": "starter-squad-3-paiement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter de la squad 3 · Paiement du Hackathon Champions AI4D (use case fictif Vélora Hôtels)",
  "engines": {
    "node": ">=22.12"
  },
  "config": {
    "squad": "squad-3-paiement",
    "port": 3003
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "scan": "node scripts/scan-pci.mjs",
    "context": "node ../context-nexus/tools/context-assemble.mjs --squad squad-3-paiement --out .context/brief.md",
    "flag": "node scripts/flag.mjs",
    "deploy": "node scripts/deploy.mjs",
    "observe": "node scripts/observe.mjs",
    "gate-check": "node scripts/gate-check.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
